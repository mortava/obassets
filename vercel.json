{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd apps/portal && npm install --no-audit --no-fund",
  "buildCommand": "cd apps/portal && npm run build",
  "outputDirectory": "apps/portal/.next",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/portal"
}
